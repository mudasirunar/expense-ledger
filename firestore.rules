rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Wipe marker (monotonic wipedAt, never deletable)
    match /users/{userId}/meta/syncState {
      allow read, create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (!('wipedAt' in resource.data) || request.resource.data.wipedAt >= resource.data.wipedAt);
      allow delete: if false;
    }

    // Tombstone registry for deleted records
    match /users/{userId}/deleted_records/{docId} {
      allow read, write: if isOwner(userId);
    }

    // User data collections (delete-wins: block writes while tombstone exists)
    match /users/{userId}/{collection}/{docId} {
      allow read, delete: if isOwner(userId) && !(collection in ['meta', 'deleted_records']);
      allow create, update: if isOwner(userId)
        && !(collection in ['meta', 'deleted_records'])
        && !existsAfter(/databases/$(database)/documents/users/$(userId)/deleted_records/$(docId));
    }
  }
}
